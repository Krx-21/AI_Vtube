# .env.example: copy to .env and fill in only what you use. Never commit .env.
# Every key is optional. Real environment variables override this file.
# Cloud LLM/STT providers also need consent in config/user.toml:
#   [privacy]
#   cloud_llm_consent = true    # Typhoon API may train on inputs; Gemini free tier is used by Google
#   cloud_stt_consent = true

# Typhoon API (cloud LLM fallback, cloud STT): https://playground.opentyphoon.ai
TYPHOON_API_KEY=

# Google Gemini (cloud LLM fallback); a paid key is recommended for privacy
GEMINI_API_KEY=

# Azure Speech (same Premwadee voice as edge-tts; F0 free tier = 20 requests/minute)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# YouTube Data API v3 key (reading YouTube live chat)
YOUTUBE_API_KEY=

# Twitch application client id (M3: EventSub/Helix; reading chat needs nothing)
TWITCH_CLIENT_ID=
